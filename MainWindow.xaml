<Window x:Class="GlassScreen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="GlassScreen"
        Icon="/GlassScreen;component/Assets/glassscreen-logo.png"
        Width="660"
        Height="760"
        MinWidth="560"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#101214"
        Foreground="#F2F5F4"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="6"
            CornerRadius="14"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <SolidColorBrush x:Key="AppBackgroundBrush"
                         Color="#101214"/>

        <SolidColorBrush x:Key="TitleBarBrush"
                         Color="#15191B"/>

        <SolidColorBrush x:Key="CardBrush"
                         Color="#1A1F21"/>

        <SolidColorBrush x:Key="SelectedCardBrush"
                         Color="#1E282B"/>

        <SolidColorBrush x:Key="CardBorderBrush"
                         Color="#313A3D"/>

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#3E6F79"/>

        <SolidColorBrush x:Key="GlassAccentBrush"
                         Color="#A9D8E1"/>

        <SolidColorBrush x:Key="MainTextBrush"
                         Color="#F2F5F4"/>

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#8E989C"/>


        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="#F5FAFB"/>

            <Setter Property="Background"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="BorderBrush"
                    Value="#568692"/>

            <Setter Property="Padding"
                    Value="16,9"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#4D818C"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource GlassAccentBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#315B64"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="#E7ECEA"/>

            <Setter Property="Background"
                    Value="#202628"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="BorderBrush"
                    Value="#394245"/>

            <Setter Property="Padding"
                    Value="15,9"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#283033"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#536064"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#181D1F"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <Style x:Key="TitleBarButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="46"/>

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#A8B3B7"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome"
                    Value="True"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBackground"
                                Background="Transparent">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#263237"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#334046"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <Style x:Key="RemoveButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="32"/>

            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="Foreground"
                    Value="#9BA5A7"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#3A161A"/>

                                <Setter Property="Foreground"
                                        Value="#FF6571"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#5A1C22"/>

                                <Setter Property="Foreground"
                                        Value="#FF8590"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <Style x:Key="ToggleSwitchStyle"
               TargetType="CheckBox">

            <Setter Property="Foreground"
                    Value="#DCE3E1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="CheckBox">

                        <StackPanel Orientation="Horizontal">

                            <Border x:Name="SwitchTrack"
                                    Width="38"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="#374144"
                                    VerticalAlignment="Center">

                                <Grid Margin="3">

                                    <Ellipse x:Name="SwitchKnob"
                                             Width="14"
                                             Height="14"
                                             Fill="#DCE4E2"
                                             HorizontalAlignment="Left"/>

                                </Grid>

                            </Border>

                            <ContentPresenter
                                Margin="9,0,0,0"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="SwitchTrack"
                                        Property="Background"
                                        Value="{StaticResource PrimaryBrush}"/>

                                <Setter TargetName="SwitchKnob"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>

                                <Setter TargetName="SwitchKnob"
                                        Property="Fill"
                                        Value="#F8FCFD"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <Style TargetType="Slider">

            <Setter Property="Height"
                    Value="24"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Slider">

                        <Grid>

                            <Border Height="4"
                                    Background="#31393C"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"/>

                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="False">

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton
                                        Command="Slider.DecreaseLarge"
                                        Opacity="0"
                                        IsTabStop="False"/>

                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>

                                    <Thumb Width="17"
                                           Height="17">

                                        <Thumb.Template>

                                            <ControlTemplate TargetType="Thumb">

                                                <Border x:Name="ThumbCircle"
                                                        Background="{StaticResource PrimaryBrush}"
                                                        BorderBrush="{StaticResource GlassAccentBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="9"/>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">

                                                        <Setter TargetName="ThumbCircle"
                                                                Property="Background"
                                                                Value="#5E8F99"/>

                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>

                                        </Thumb.Template>

                                    </Thumb>

                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>

                                    <RepeatButton
                                        Command="Slider.IncreaseLarge"
                                        Opacity="0"
                                        IsTabStop="False"/>

                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <Style TargetType="ScrollBar">

            <Setter Property="Width"
                    Value="9"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ScrollBar">

                        <Grid Background="Transparent">

                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Focusable="False">

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton
                                        Command="ScrollBar.PageUpCommand"
                                        Opacity="0"
                                        IsTabStop="False"/>

                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>

                                    <Thumb>

                                        <Thumb.Template>

                                            <ControlTemplate TargetType="Thumb">

                                                <Border Background="#414B4E"
                                                        CornerRadius="4"
                                                        Margin="2"/>

                                            </ControlTemplate>

                                        </Thumb.Template>

                                    </Thumb>

                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>

                                    <RepeatButton
                                        Command="ScrollBar.PageDownCommand"
                                        Opacity="0"
                                        IsTabStop="False"/>

                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <Border Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="#343C3E"
            BorderThickness="1"
            CornerRadius="14">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Border Grid.Row="0"
                    Background="{StaticResource TitleBarBrush}"
                    CornerRadius="14,14,0,0">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">

                        <Border Width="30"
                                Height="30"
                                CornerRadius="6"
                                Background="{StaticResource AppBackgroundBrush}"
                                ClipToBounds="True"
                                Margin="0,0,8,0">

                            <Image Source="/GlassScreen;component/Assets/glassscreen-logo.png"
                                   Stretch="Uniform"/>

                        </Border>

                        <TextBlock Text="GlassScreen"
                                   VerticalAlignment="Center"
                                   Foreground="#DCE3E1"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>

                    </StackPanel>


                    <Button Grid.Column="1"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="MinimizeButton_Click">

                        <Path Width="12"
                              Height="1"
                              Stretch="Fill"
                              Stroke="{Binding Foreground,
                              RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              Data="M 0,0 L 12,0"/>

                    </Button>


                    <Button Grid.Column="2"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="MaximizeButton_Click">

                        <Path Width="11"
                              Height="11"
                              Stretch="Fill"
                              Stroke="{Binding Foreground,
                              RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2"
                              Fill="Transparent"
                              Data="M 0,0 L 11,0 L 11,11 L 0,11 Z"/>

                    </Button>


                    <Button Grid.Column="3"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="CloseButton_Click">

                        <Path Width="11"
                              Height="11"
                              Stretch="Fill"
                              Stroke="{Binding Foreground,
                              RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3"
                              Data="M 0,0 L 11,11 M 11,0 L 0,11"/>

                    </Button>

                </Grid>

            </Border>


            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="30">


                    <Grid Margin="0,4,0,28">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <Border Grid.Column="0"
                                Width="64"
                                Height="64"
                                CornerRadius="13"
                                Background="{StaticResource AppBackgroundBrush}"
                                ClipToBounds="True"
                                Margin="0,0,15,0">

                            <Image Source="/GlassScreen;component/Assets/glassscreen-logo.png"
                                   Stretch="Uniform"/>

                        </Border>


                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">

                            <TextBlock Text="GlassScreen"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MainTextBrush}"/>

                            <TextBlock Text="See through your workspace"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,3,0,0"/>

                        </StackPanel>

                    </Grid>


                    <Grid Margin="0,0,0,14">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Grid.Column="0"
                                   Text="WINDOWS"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"/>


                        <Button Grid.Column="1"
                                x:Name="PickWindowButton"
                                Content="+ Add Window"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="PickWindowButton_Click"/>

                    </Grid>


                    <Border x:Name="EmptyStateCard"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="28"
                            Margin="0,0,0,14">

                        <StackPanel>

                            <TextBlock x:Name="NoWindowsText"
                                       Text="No windows selected"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource MainTextBrush}"/>

                            <TextBlock Text="Add a window to control its transparency."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>

                        </StackPanel>

                    </Border>


                    <ListBox x:Name="SelectedWindowsList"
                             MaxHeight="420"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionMode="Single"
                             Margin="0,0,0,14">

                        <ListBox.Resources>

                            <SolidColorBrush
                                x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                Color="Transparent"/>

                            <SolidColorBrush
                                x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                Color="Transparent"/>

                            <SolidColorBrush
                                x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                Color="#F2F5F4"/>

                        </ListBox.Resources>


                        <ListBox.ItemContainerStyle>

                            <Style TargetType="ListBoxItem">

                                <Setter Property="Background"
                                        Value="Transparent"/>

                                <Setter Property="BorderThickness"
                                        Value="0"/>

                                <Setter Property="Padding"
                                        Value="0"/>

                                <Setter Property="Margin"
                                        Value="0"/>

                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch"/>

                                <Setter Property="FocusVisualStyle"
                                        Value="{x:Null}"/>

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="ListBoxItem">

                                            <ContentPresenter
                                                HorizontalAlignment="Stretch"/>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                            </Style>

                        </ListBox.ItemContainerStyle>


                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border x:Name="WindowCardBorder"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="18"
                                        Margin="0,0,0,12"
                                        HorizontalAlignment="Stretch"
                                        Loaded="WindowCard_Loaded">

                                    <StackPanel>


                                        <Grid Margin="0,0,0,18">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>


                                            <StackPanel Grid.Column="0">

                                                <TextBlock
                                                    Text="{Binding Window.Title}"
                                                    FontWeight="SemiBold"
                                                    FontSize="15"
                                                    Foreground="{StaticResource MainTextBrush}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap"
                                                    Margin="0,0,10,0"/>

                                                <TextBlock
                                                    Text="Window"
                                                    Foreground="{StaticResource MutedTextBrush}"
                                                    FontSize="11"
                                                    Margin="0,3,0,0"/>

                                            </StackPanel>


                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource RemoveButtonStyle}"
                                                    Click="RemoveWindowButton_Click"/>

                                        </Grid>


                                        <Grid Margin="0,0,0,8">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>


                                            <TextBlock Grid.Column="0"
                                                       Text="Opacity"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"/>


                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Opacity, StringFormat={}{0}%}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource GlassAccentBrush}"/>

                                        </Grid>


                                        <Slider Minimum="10"
                                                Maximum="100"
                                                Value="{Binding Opacity, Mode=TwoWay}"
                                                TickFrequency="5"
                                                Margin="0,0,0,18"
                                                ValueChanged="WindowOpacitySlider_ValueChanged"/>


                                        <WrapPanel>

                                            <CheckBox
                                                Content="Click Through"
                                                IsChecked="{Binding ClickThrough, Mode=TwoWay}"
                                                Style="{StaticResource ToggleSwitchStyle}"
                                                Margin="0,0,28,0"
                                                Checked="WindowClickThroughCheckBox_Changed"
                                                Unchecked="WindowClickThroughCheckBox_Changed"/>

                                            <CheckBox
                                                Content="Always On Top"
                                                IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"
                                                Style="{StaticResource ToggleSwitchStyle}"
                                                Checked="WindowAlwaysOnTopCheckBox_Changed"
                                                Unchecked="WindowAlwaysOnTopCheckBox_Changed"/>

                                        </WrapPanel>

                                    </StackPanel>


                                    <Border.Style>

                                        <Style TargetType="Border">

                                            <Setter Property="Background"
                                                    Value="{StaticResource CardBrush}"/>

                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource CardBorderBrush}"/>

                                            <Style.Triggers>

                                                <DataTrigger
                                                    Binding="{Binding IsSelected,
                                                    RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                    Value="True">

                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource GlassAccentBrush}"/>

                                                    <Setter Property="Background"
                                                            Value="{StaticResource SelectedCardBrush}"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Border.Style>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>


                    <WrapPanel Margin="0,4,0,0">

                        <Button x:Name="RestoreButton"
                                Content="Restore Active"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,10,0"
                                Click="RestoreButton_Click"/>

                        <Button x:Name="RestoreAllButton"
                                Content="Restore All"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="RestoreAllButton_Click"/>

                    </WrapPanel>


                    <Separator Margin="0,26,0,22"
                               Background="#313A3D"/>


                    <TextBlock Text="KEYBOARD SHORTCUTS"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,0,0,13"/>


                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Ctrl + Alt + N"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="Next active window"
                                   Foreground="{StaticResource MutedTextBrush}"/>


                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Ctrl + Alt + ↑ / ↓"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="Change opacity"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,8,0,0"/>


                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Ctrl + Alt + T"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="Toggle click-through"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,8,0,0"/>


                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="Ctrl + Alt + A"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Text="Toggle always-on-top"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,8,0,0"/>


                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="Ctrl + Alt + R"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>

                        <TextBlock Grid.Row="4"
                                   Grid.Column="1"
                                   Text="Restore active window"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,8,0,0"/>


                        <TextBlock Grid.Row="5"
                                   Grid.Column="0"
                                   Text="Ctrl + Alt + Shift + R"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>

                        <TextBlock Grid.Row="5"
                                   Grid.Column="1"
                                   Text="Restore all windows"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,8,0,0"/>


                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   Text="Ctrl + Alt + G"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>

                        <TextBlock Grid.Row="6"
                                   Grid.Column="1"
                                   Text="Show GlassScreen"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,8,0,0"/>

                    </Grid>


                    <Border Background="#15191B"
                            BorderBrush="#2C3538"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,24,0,0">

                        <TextBlock x:Name="StatusText"
                                   Text="Ready"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"/>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Border>

</Window>
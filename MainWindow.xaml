<Window x:Class="GlassScreen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassScreen"
        Width="660"
        Height="760"
        MinWidth="560"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117"
        Foreground="#F4F6FA">

    <Window.Resources>

        <!-- ============================= -->
        <!-- COLORS / BRUSHES              -->
        <!-- ============================= -->

        <SolidColorBrush x:Key="CardBrush"
                         Color="#181B23"/>

        <SolidColorBrush x:Key="CardBorderBrush"
                         Color="#292E3A"/>

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#7C8CFF"/>

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#9298A7"/>

        <!-- ============================= -->
        <!-- NORMAL BUTTON                 -->
        <!-- ============================= -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="16,9"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ============================= -->
        <!-- SECONDARY BUTTON              -->
        <!-- ============================= -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="#E4E7EE"/>

            <Setter Property="Background"
                    Value="#222630"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="BorderBrush"
                    Value="#343A48"/>

            <Setter Property="Padding"
                    Value="15,9"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

<!-- ============================= -->
<!-- REMOVE X BUTTON               -->
<!-- ============================= -->

<Style x:Key="RemoveButtonStyle"
       TargetType="Button">

    <Setter Property="Width"
            Value="32"/>

    <Setter Property="Height"
            Value="32"/>

    <!-- Normal X color -->
    <Setter Property="Foreground"
            Value="#9CA3B3"/>

    <Setter Property="Background"
            Value="Transparent"/>

    <Setter Property="BorderThickness"
            Value="0"/>

    <Setter Property="FontSize"
            Value="16"/>

    <Setter Property="Cursor"
            Value="Hand"/>

    <Setter Property="Template">

        <Setter.Value>

            <ControlTemplate TargetType="Button">

                <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6">

                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>

                <ControlTemplate.Triggers>

                    <!-- Mouse hovering over X -->
                    <Trigger Property="IsMouseOver"
                             Value="True">

                        <Setter Property="Background"
                                Value="#3A161A"/>

                        <Setter Property="Foreground"
                                Value="#FF5A67"/>

                    </Trigger>

                    <!-- X being clicked -->
                    <Trigger Property="IsPressed"
                             Value="True">

                        <Setter Property="Background"
                                Value="#5A1C22"/>

                        <Setter Property="Foreground"
                                Value="#FF7A84"/>

                    </Trigger>

                </ControlTemplate.Triggers>

            </ControlTemplate>

        </Setter.Value>

    </Setter>

</Style>

    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="30">

            <!-- ============================= -->
            <!-- HEADER                        -->
            <!-- ============================= -->

            <Grid Margin="0,0,0,28">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Temporary logo until we make our real icon -->

                <Border Grid.Column="0"
                        Width="50"
                        Height="50"
                        CornerRadius="12"
                        Background="{StaticResource PrimaryBrush}"
                        Margin="0,0,14,0">

                    <TextBlock Text="G"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="GlassScreen"
                               FontSize="25"
                               FontWeight="Bold"/>

                    <TextBlock Text="See through your workspace"
                               FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,3,0,0"/>

                </StackPanel>

            </Grid>

            <!-- ============================= -->
            <!-- WINDOWS HEADER                -->
            <!-- ============================= -->

            <Grid Margin="0,0,0,14">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="WINDOWS"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        x:Name="PickWindowButton"
                        Content="+ Add Window"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="PickWindowButton_Click"/>

            </Grid>

            <!-- ============================= -->
            <!-- EMPTY STATE                   -->
            <!-- ============================= -->

            <Border x:Name="EmptyStateCard"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28"
                    Margin="0,0,0,14">

                <StackPanel>

                    <TextBlock x:Name="NoWindowsText"
                               Text="No windows selected"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Add a window to control its transparency."
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>

                </StackPanel>

            </Border>

            <!-- ============================= -->
            <!-- WINDOW CARDS                  -->
            <!-- ============================= -->

        <ListBox x:Name="SelectedWindowsList"
         MaxHeight="420"
         BorderThickness="0"
         Background="Transparent"
         HorizontalContentAlignment="Stretch"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         ScrollViewer.VerticalScrollBarVisibility="Auto"
         SelectionMode="Single"
         Margin="0,0,0,14">

    <ListBox.Resources>

        <!-- Remove the default bright selection/background -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                         Color="Transparent"/>

        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                         Color="Transparent"/>

        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                         Color="#F4F6FA"/>

    </ListBox.Resources>

    <ListBox.ItemContainerStyle>

        <Style TargetType="ListBoxItem">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Margin"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ListBoxItem">

                        <ContentPresenter
                            HorizontalAlignment="Stretch"/>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </ListBox.ItemContainerStyle>

    <ListBox.ItemTemplate>

        <DataTemplate>

            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Stretch"
                    Loaded="WindowCard_Loaded">

                <StackPanel>

                    <!-- TITLE -->

                    <Grid Margin="0,0,0,18"
                          HorizontalAlignment="Stretch">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    MinWidth="0">

                            <TextBlock Text="{Binding Window.Title}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="#F4F6FA"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       Margin="0,0,10,0"/>

                            <TextBlock Text="Window"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       Margin="0,3,0,0"/>

                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="✕"
                                Tag="{Binding}"
                                Style="{StaticResource RemoveButtonStyle}"
                                Click="RemoveWindowButton_Click"/>

                    </Grid>

                    <!-- OPACITY -->

                    <Grid Margin="0,0,0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Opacity"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Opacity, StringFormat={}{0}%}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"/>

                    </Grid>

                    <Slider Minimum="10"
                            Maximum="100"
                            Value="{Binding Opacity, Mode=TwoWay}"
                            TickFrequency="5"
                            Margin="0,0,0,18"
                            ValueChanged="WindowOpacitySlider_ValueChanged"/>

                    <!-- SETTINGS -->

                    <WrapPanel>

                        <CheckBox Content="Click Through"
                                  IsChecked="{Binding ClickThrough, Mode=TwoWay}"
                                  Foreground="#D7DAE2"
                                  Margin="0,0,28,0"
                                  VerticalAlignment="Center"
                                  Checked="WindowClickThroughCheckBox_Changed"
                                  Unchecked="WindowClickThroughCheckBox_Changed"/>

                        <CheckBox Content="Always On Top"
                                  IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"
                                  Foreground="#D7DAE2"
                                  VerticalAlignment="Center"
                                  Checked="WindowAlwaysOnTopCheckBox_Changed"
                                  Unchecked="WindowAlwaysOnTopCheckBox_Changed"/>

                    </WrapPanel>

                </StackPanel>

            </Border>

        </DataTemplate>

    </ListBox.ItemTemplate>

</ListBox>

            <!-- ============================= -->
            <!-- RESTORE CONTROLS              -->
            <!-- ============================= -->

            <WrapPanel Margin="0,4,0,0">

                <Button x:Name="RestoreButton"
                        Content="Restore Active"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0"
                        Click="RestoreButton_Click"/>

                <Button x:Name="RestoreAllButton"
                        Content="Restore All"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RestoreAllButton_Click"/>

            </WrapPanel>

            <Separator Margin="0,26,0,22"
                       Background="#292E3A"/>

            <!-- ============================= -->
            <!-- HOTKEY HELP                   -->
            <!-- ============================= -->

            <TextBlock Text="KEYBOARD SHORTCUTS"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,0,0,13"/>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Ctrl + Alt + N"
                           FontWeight="SemiBold"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="Next active window"
                           Foreground="{StaticResource MutedTextBrush}"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Ctrl + Alt + ↑ / ↓"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="Change opacity"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,8,0,0"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Ctrl + Alt + T"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="Toggle click-through"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,8,0,0"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Ctrl + Alt + A"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Text="Toggle always-on-top"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,8,0,0"/>

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Ctrl + Alt + R"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>

                <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Text="Restore active window"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,8,0,0"/>

                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Text="Ctrl + Alt + Shift + R"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>

                <TextBlock Grid.Row="5"
                           Grid.Column="1"
                           Text="Restore all windows"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,8,0,0"/>

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="Ctrl + Alt + G"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>

                <TextBlock Grid.Row="6"
                           Grid.Column="1"
                           Text="Show GlassScreen"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,8,0,0"/>

            </Grid>

            <!-- ============================= -->
            <!-- STATUS                        -->
            <!-- ============================= -->

            <Border Background="#151820"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,24,0,0">

                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"/>

            </Border>

        </StackPanel>

    </ScrollViewer>

</Window>
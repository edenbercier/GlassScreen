<Window x:Class="GlassScreen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassScreen"
        Width="620"
        Height="720"
        MinWidth="520"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="24">

            <TextBlock Text="GlassScreen"
                       FontSize="26"
                       FontWeight="Bold"/>

            <TextBlock Text="Make any window transparent and click-through."
                       Foreground="Gray"
                       Margin="0,4,0,24"/>

            <TextBlock Text="Selected Windows"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="NoWindowsText"
                       Text="No windows selected"
                       Foreground="Gray"
                       Margin="0,4,0,12"/>

            <ListBox x:Name="SelectedWindowsList"
                     MaxHeight="430"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     SelectionMode="Single"
                     Margin="0,0,0,12">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <Border BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,10"
                                Loaded="WindowCard_Loaded">

                            <StackPanel>

                                <!-- Window title + remove button -->
                                <Grid Margin="0,0,0,14">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Window.Title}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,12,0"/>

                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Width="32"
                                            Height="32"
                                            Tag="{Binding}"
                                            Click="RemoveWindowButton_Click"/>

                                </Grid>

                                <!-- Opacity -->
                                <Grid Margin="0,0,0,6">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Opacity"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Opacity, StringFormat={}{0}%}"
                                               FontWeight="SemiBold"/>

                                </Grid>

                                <Slider Minimum="10"
                                        Maximum="100"
                                        Value="{Binding Opacity, Mode=TwoWay}"
                                        TickFrequency="5"
                                        Margin="0,0,0,14"
                                        ValueChanged="WindowOpacitySlider_ValueChanged"/>

                                <!-- Per-window switches -->
                                <CheckBox Content="Click Through"
                                          IsChecked="{Binding ClickThrough, Mode=TwoWay}"
                                          Margin="0,0,0,10"
                                          Checked="WindowClickThroughCheckBox_Changed"
                                          Unchecked="WindowClickThroughCheckBox_Changed"/>

                                <CheckBox Content="Always On Top"
                                          IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"
                                          Checked="WindowAlwaysOnTopCheckBox_Changed"
                                          Unchecked="WindowAlwaysOnTopCheckBox_Changed"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

            <Button x:Name="PickWindowButton"
                    Content="+ Add Window"
                    Width="150"
                    Height="40"
                    HorizontalAlignment="Left"
                    Click="PickWindowButton_Click"/>

            <Separator Margin="0,22,0,18"/>

            <StackPanel Orientation="Horizontal">

                <Button x:Name="RestoreButton"
                        Content="Restore Active Window"
                        Width="175"
                        Height="40"
                        Click="RestoreButton_Click"/>

                <Button x:Name="RestoreAllButton"
                        Content="Restore All"
                        Width="120"
                        Height="40"
                        Margin="12,0,0,0"
                        Click="RestoreAllButton_Click"/>

            </StackPanel>

            <TextBlock Text="Keyboard Shortcuts"
                       FontWeight="Bold"
                       Margin="0,24,0,8"/>

            <TextBlock Text="Ctrl + Alt + ↑ / ↓   Opacity"
                       Foreground="Gray"/>

            <TextBlock Text="Ctrl + Alt + T          Click Through"
                       Foreground="Gray"
                       Margin="0,3,0,0"/>

            <TextBlock Text="Ctrl + Alt + A          Always On Top"
                       Foreground="Gray"
                       Margin="0,3,0,0"/>

            <TextBlock Text="Ctrl + Alt + R          Restore Active"
                       Foreground="Gray"
                       Margin="0,3,0,0"/>

            <TextBlock Text="Ctrl + Alt + G          Show GlassScreen"
                       Foreground="Gray"
                       Margin="0,3,0,0"/>

            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       Foreground="Gray"
                       Margin="0,22,0,0"/>

        </StackPanel>

    </ScrollViewer>

</Window>
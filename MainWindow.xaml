<Window x:Class="GlassScreen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassScreen"
        Width="560"
        Height="650"
        MinWidth="500"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Selected windows -->
            <StackPanel Grid.Row="0">

                <TextBlock Text="Selected Windows"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="0,0,0,8"/>

                <ScrollViewer MaxHeight="160"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,12">

                    <ItemsControl x:Name="SelectedWindowsList">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border BorderBrush="#D0D0D0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        Margin="0,0,0,6">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,12,0"/>

                                        <Button Grid.Column="1"
                                                Content="✕"
                                                Width="30"
                                                Height="30"
                                                Tag="{Binding}"
                                                Click="RemoveWindowButton_Click"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

                <TextBlock x:Name="NoWindowsText"
                           Text="No windows selected"
                           Foreground="Gray"
                           Margin="0,0,0,12"/>

                <Button x:Name="PickWindowButton"
                        Content="+ Add Window"
                        Width="140"
                        Height="36"
                        HorizontalAlignment="Left"
                        Click="PickWindowButton_Click"/>

            </StackPanel>

            <!-- Opacity -->
            <StackPanel Grid.Row="1"
                        Margin="0,22,0,0">

                <TextBlock x:Name="OpacityLabel"
                           Text="Opacity: 100%"
                           FontWeight="Bold"/>

                <Slider x:Name="OpacitySlider"
                        Minimum="10"
                        Maximum="100"
                        Value="100"
                        TickFrequency="10"
                        Margin="0,8,0,0"
                        ValueChanged="OpacitySlider_ValueChanged"/>

            </StackPanel>

            <!-- Click through -->
            <CheckBox Grid.Row="2"
                      x:Name="ClickThroughCheckBox"
                      Content="Click Through"
                      Margin="0,22,0,0"
                      Checked="ClickThroughCheckBox_Changed"
                      Unchecked="ClickThroughCheckBox_Changed"/>

            <!-- Always on top -->
            <CheckBox Grid.Row="3"
                      x:Name="AlwaysOnTopCheckBox"
                      Content="Always On Top"
                      Margin="0,12,0,0"
                      Checked="AlwaysOnTopCheckBox_Changed"
                      Unchecked="AlwaysOnTopCheckBox_Changed"/>

            <!-- Restore buttons -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        Margin="0,24,0,0">

                <Button x:Name="RestoreButton"
                        Content="Restore Selected Windows"
                        Width="190"
                        Height="38"
                        Click="RestoreButton_Click"/>

                <Button x:Name="RestoreAllButton"
                        Content="Restore All"
                        Width="120"
                        Height="38"
                        Margin="12,0,0,0"
                        Click="RestoreAllButton_Click"/>

            </StackPanel>

            <!-- Status -->
            <TextBlock Grid.Row="5"
                       x:Name="StatusText"
                       Text="Ready"
                       Margin="0,20,0,0"
                       Foreground="Gray"/>

        </Grid>

    </ScrollViewer>

</Window>